<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemRecipeIv"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/itemRecipeTitleTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/ownerActionsLayout"
                    android:layout_centerVertical="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#1A202C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Recipe Title" />

                <LinearLayout
                    android:id="@+id/ownerActionsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnEditRecipe"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:tint="@color/colorSecondary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Edit"
                        android:src="@drawable/edite_icon"
                       />

                    <ImageView
                        android:id="@+id/btnDeleteRecipe"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:tint="@color/errorRed"
                        android:contentDescription="Delete"
                        android:src="@drawable/delete_icon"
                      />
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/itemRecipeCategoryTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#EDF2F7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="#4A5568"
                android:textSize="12sp"
                tools:text="Desserts" />

            <TextView
                android:id="@+id/itemRecipeDescTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#718096"
                android:textSize="13sp"
                tools:text="Short description about the recipe goes here..." />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>